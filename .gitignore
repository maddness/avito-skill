*~

# Track only the skill, its usage guide and offline checks.
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE
!/SKILL.md
!/scripts/
!/references/
!/assets/
!/tests/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/avito-check.yml

/scripts/**
!/scripts/avito.mjs
!/scripts/lib/
/scripts/lib/**
!/scripts/lib/*.mjs

/references/**
!/references/*.md

/assets/*
!/assets/cover.png
!/assets/listing.example.json

/tests/*
!/tests/README.md
!/tests/*.mjs
